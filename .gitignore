# -------------------------
# Python cache files
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd


# -------------------------
# Training artifacts
# -------------------------
# The trained value function and the training log ARE shared: everyone must
# evaluate with the same weights, and the graph/csv are report evidence.
# Intermediate checkpoints from other runs stay local.
checkpoints/*
!checkpoints/value_function.npz

# -------------------------
# Virtual environments
# -------------------------
venv/
env/
ENV/
.venv/

# -------------------------
# PyCharm / VSCode
# -------------------------
.idea/
.vscode/

# -------------------------
# OS files (Mac)
# -------------------------
.DS_Store

# -------------------------
# Logs and outputs
# -------------------------
*.log
output/
logs/

# -------------------------
# PyTorch / ML artifacts
# -------------------------
*.pt
*.pth
*.pkl
*.model

# -------------------------
# Testing cache
# -------------------------
.pytest_cache/
.coverage

# -------------------------
# Mypy / type checker
# -------------------------
.mypy_cache/